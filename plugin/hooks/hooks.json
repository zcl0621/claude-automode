{
  "description": "automode: classify tool calls that would otherwise show a permission prompt",
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.py\"",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
